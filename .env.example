MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=pi5
MQTT_PASS=your_mqtt_password_here
PIRONMAN_API=http://localhost:34001/api/v1.0
TOPIC_FAST=pi5/fast
TOPIC_SLOW=pi5/slow
TOPIC_CTRL=pi5/control/pironman
TOPIC_SERVICES=pi5/services
TOPIC_DOCKER=pi5/docker
TOPIC_CTRL_SERVICES=pi5/control/services
TOPIC_STATUS=pi5/status
INTERVAL_FAST=1
INTERVAL_SLOW=30

# Serve the dashboard build from this folder. Leave HTTP_PORT empty to disable.
# 0.0.0.0 listens on every interface; restrict who reaches it with ufw.
HTTP_HOST=0.0.0.0
HTTP_PORT=3010
WEB_ROOT=public

# Network interface to measure traffic on (eth0, wlan0, wg0...).
# Empty picks the one your internet goes through.
NET_INTERFACE=

# Host-specific metrics. Leave any of these empty to skip it entirely.
WG_INTERFACE=wg0
NVME_DEVICE=/dev/nvme0
F2B_JAIL=sshd
FAN_INPUT=/sys/class/hwmon/hwmon0/fan1_input
CS_ENABLE=false
